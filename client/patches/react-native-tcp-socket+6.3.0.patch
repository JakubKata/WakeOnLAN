+package com.asterinet.react.tcpsocket;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import javax.net.ssl.SSLParameters;
+import javax.net.ssl.SSLSocket;
+
+/** Application policy: CA trust, hostname verification and TLS 1.2 or newer. */
+final class TlsSocketPolicy {
+    private TlsSocketPolicy() {}
+
+    static void handshake(SSLSocket socket) throws IOException {
+        socket.setUseClientMode(true);
+        SSLParameters parameters = socket.getSSLParameters();
+        parameters.setEndpointIdentificationAlgorithm("HTTPS");
+        List<String> protocols = new ArrayList<>();
+        for (String protocol : socket.getSupportedProtocols()) {
+            if (protocol.equals("TLSv1.3") || protocol.equals("TLSv1.2")) protocols.add(protocol);
+        }
+        if (protocols.isEmpty()) throw new IOException("TLS 1.2 or newer is required");
+        parameters.setProtocols(protocols.toArray(new String[0]));
+        socket.setSSLParameters(parameters);
+        int previousTimeout = socket.getSoTimeout();
+        socket.setSoTimeout(10000);
+        socket.startHandshake();
+        socket.setSoTimeout(previousTimeout);
+    }
+}
