{
  "expo": {
    "name": "Wake on LAN",
    "slug": "wol-client",
    "scheme": "wol",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.wol.client",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withProvisioning",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wake on LAN to scan the setup code on your device.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "serverHost": "wol.example.com",
      "serverPort": 8443
    }
  }
}
