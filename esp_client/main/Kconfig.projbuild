menu "Wake-on-LAN client"

    config WOL_WIFI_SSID
        string "WiFi SSID"
        default ""

    config WOL_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            Leave empty for an open network.

    config WOL_SERVER_HOST
        string "Server host"
        default "192.168.1.10"
        help
            Must match the CN/SAN of the server certificate unless
            WOL_SKIP_CN_CHECK is enabled.

    config WOL_SERVER_PORT
        int "Server device port"
        range 1 65535
        default 8444

    config WOL_CLAIM_TOKEN
        string "Claim token"
        default ""
        help
            One-time token from CREATE_CLAIM, used only while the device has
            no credentials stored in NVS. Valid for 10 minutes. A token entered
            on the serial console ("claim <token>") takes precedence; a token
            the server has consumed or rejected is never sent again.

    config WOL_SKIP_CN_CHECK
        bool "Skip server certificate hostname check"
        default n
        help
            The certificate chain is still verified. Only for development
            with a certificate that does not name the server host.

endmenu
