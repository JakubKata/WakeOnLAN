# Copy to .env and fill in. Never commit .env.

SERVER_HOST=0.0.0.0
CLIENT_PORT=8443
DEVICE_PORT=8444

# Relative paths are resolved against the server/ directory.
# Development certificate:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 -keyout server.key -out server.crt -subj "/CN=your.host"
TLS_CERT_FILE=server.crt
TLS_KEY_FILE=server.key

# Dedicated role and database, e.g. as the postgres superuser:
#   CREATE ROLE wol LOGIN PASSWORD 'change-me';
#   CREATE DATABASE wol OWNER wol;
# For a remote database append ?sslmode=verify-full
DATABASE_URL=postgresql://wol:change-me@localhost:5432/wol
DB_POOL_SIZE=10

# Only for docker-compose.yml: password of the bundled PostgreSQL. Compose then
# sets DATABASE_URL and TLS_CERT_FILE/TLS_KEY_FILE (certs/server.crt, certs/server.key) itself.
# It is inserted into that URL unescaped: use only letters, digits and - _ . ~
POSTGRES_PASSWORD=

# HMAC key for every token stored in the database. At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates all sessions and all paired devices.
TOKEN_PEPPER=

LOG_LEVEL=INFO

# Outgoing mail for password reset codes. Leave SMTP_HOST empty to disable reset.
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none (port 25, no login allowed).
# Gmail: smtp.gmail.com, starttls, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>.
SMTP_HOST=
SMTP_SECURITY=starttls
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=WoL Server
